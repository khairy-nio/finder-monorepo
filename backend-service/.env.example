# =============================================================================
# Finder Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3500
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. 
# If DATABASE_URL is set, the application will use PostgreSQL.
# If DATABASE_URL is left blank, the application will automatically fall back to
# a deterministic local SQLite database file: `backend-service/lost_and_found.sqlite`.
DATABASE_URL=

# ── JWT (Admin Dashboard Auth) ────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
# NEVER use the example value in production.
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_RUN_openssl_rand_-hex_64
JWT_EXPIRES_IN=24h

# ── Admin Seed Credentials ────────────────────────────────────────────────────
# Used only by: node scripts/seedAdmin.js
# Change these before running seed in production.
ADMIN_EMAIL=admin@finder.app
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_NAME=Dashboard Admin

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Paste the entire service account JSON as a single-line string.
# Get it from: Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT=

# ── AI Microservice ───────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── Pinecone Vector Database ──────────────────────────────────────────────────
PINECONE_API_KEY=

# ── Cloudinary (Image Storage) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── CORS Allowed Origins ──────────────────────────────────────────────────────
# Comma-separated list of origins allowed to access the API.
# The admin dashboard Vercel URL is always allowed (hardcoded in server.js).
# Add local dev URLs here.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Local Development Only ────────────────────────────────────────────────────
# Set DEV_FIREBASE_UID to your real Firebase UID so that localDevSeed.js creates
# a user row that actually matches your Firebase token.
# Find your UID: Firebase Console → Authentication → Users → copy the User UID column.
# Without this, verfyFirebaseToken will return "User not found" for all requests.
DEV_FIREBASE_UID=
DEV_USER_EMAIL=

# ── Sequelize Tuning (optional) ───────────────────────────────────────────────
SEQUELIZE_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
