@startuml DFD-2-Process1-Manage-Posts
title Level 2 — Process 1.0: Manage Posts

skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam arrowFontSize 10
skinparam arrowThickness 1.2
skinparam rectangle { BorderColor black }
skinparam database  { BorderColor black }

left to right direction

rectangle "User" as U

rectangle "1.1\n─────────────\nValidate\nPost Data" as P11
rectangle "1.2\n─────────────\nUpload\nImage"        as P12
rectangle "1.3\n─────────────\nStore Post"           as P13
rectangle "1.4\n─────────────\nUpdate Feed"          as P14

database "D1  Posts Database" as D1
database "Cloudinary"         as CDN

U   --> P11 : "Post Data"
P11 --> U   : "Error"
P11 --> P12 : "Validated Post"
P12 <--> CDN : "Image URL"
P12 --> P13 : "Post + Image URL"
P13 --> D1  : "Store"
P13 --> P14 : "Post Stored"
P14 <--> D1
P14 --> U   : "Confirmation"

@enduml
